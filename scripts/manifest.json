{
  "name": "Cindy Plugins Market",
  "owner": "otaku-say",
  "repo": "cindy-plugins",
  "description": "Cindy 自定义插件市场（官方与社区高质量插件，支持全操作系统与架构自动适配）",
  "platforms": {
    "macos-arm64": {
      "os": "macos",
      "arch": "arm64",
      "target": "aarch64-macos",
      "name_label": "macOS Apple Silicon (arm64)",
      "ext": ""
    },
    "macos-amd64": {
      "os": "macos",
      "arch": "amd64",
      "target": "x86_64-macos",
      "name_label": "macOS Intel (amd64)",
      "ext": ""
    },
    "windows-amd64": {
      "os": "windows",
      "arch": "amd64",
      "target": "x86_64-windows-gnu",
      "name_label": "Windows 64-bit (amd64)",
      "ext": ".exe"
    },
    "windows-arm64": {
      "os": "windows",
      "arch": "arm64",
      "target": "aarch64-windows-gnu",
      "name_label": "Windows ARM64 (arm64)",
      "ext": ".exe"
    },
    "linux-amd64": {
      "os": "linux",
      "arch": "amd64",
      "target": "x86_64-linux-musl",
      "name_label": "Linux 64-bit (amd64)",
      "ext": ""
    },
    "linux-arm64": {
      "os": "linux",
      "arch": "arm64",
      "target": "aarch64-linux-musl",
      "name_label": "Linux ARM64 (arm64)",
      "ext": ""
    }
  },
  "plugins": {
    "cube-cli": {
      "id": "cube-cli",
      "name": "Cube CLI",
      "description": "CubeSandbox 控制面遥控器：创建、管理沙箱生命周期、端口与文件操作",
      "version": "0.2.4",
      "command": "cube",
      "author": "otaku-say",
      "tags": [
        "sandbox",
        "cloud",
        "cube-cli",
        "remote-control"
      ],
      "upstream": {
        "repo": "otaku-say/cube-cli",
        "tag": "latest",
        "artifact_template": "cube-cli-{os}-{arch}{ext}",
        "binary_name": "cube-cli{ext}"
      }
    },
    "aiod-cli": {
      "id": "aiod-cli",
      "name": "Aiod CLI",
      "description": "CubeSandbox 沙箱内 aiod v2 API 遥控器：进程执行、文件管理、浏览器与 MCP",
      "version": "0.2.2",
      "command": "aiod",
      "author": "otaku-say",
      "tags": [
        "sandbox",
        "aiod",
        "exec",
        "files",
        "browser",
        "mcp"
      ],
      "upstream": {
        "repo": "otaku-say/aiod-cli",
        "tag": "latest",
        "artifact_template": "aiod-cli-{os}-{arch}{ext}",
        "binary_name": "aiod-cli{ext}",
        "supported_platforms": [
          "macos-arm64",
          "macos-amd64",
          "windows-amd64",
          "windows-arm64",
          "linux-amd64",
          "linux-arm64"
        ]
      }
    },
    "my-env": {
      "id": "my-env",
      "name": "My Env",
      "description": "跨平台环境变量与密钥安全中枢：安全将凭据注入云端沙箱、容器与本地命令，彻底避免对话明文泄露",
      "version": "0.2.4",
      "command": "env",
      "author": "otaku-say",
      "tags": [
        "env",
        "credentials",
        "secrets",
        "sandbox",
        "token",
        "security"
      ]
    },
    "subagent-router": {
      "id": "subagent-router",
      "name": "Subagent Router",
      "description": "子代理模型链与分组：按分组挑选模型、拖动排序，失败自动换下一个",
      "version": "0.1.6",
      "command": "router",
      "author": "otaku-say",
      "tags": [
        "subagent",
        "model-routing",
        "fallback",
        "pi-extension",
        "groups"
      ]
    }
  }
}
