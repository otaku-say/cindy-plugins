{
  "schemaVersion": 3,
  "id": "cube-cli",
  "name": "Cube CLI",
  "description": "CubeSandbox 控制面遥控器：创建、管理沙箱生命周期、端口与文件操作",
  "whenToUse": "需要创建、列出、检查、暂停、恢复、快照、克隆或删除 CubeSandbox，或排查控制面连接时",
  "version": "0.1.1",
  "minCindyVersion": "3.0.0",
  "entry": "main.js",
  "command": "cube",
  "icon": "assets/icon.png",
  "manual": {
    "items": [
      {
        "dir": "manual/guide",
        "name": "guide",
        "description": "Cube CLI 完整使用手册与沙箱控制面工作流指引"
      }
    ]
  },
  "settingsHtml": "settings.html",
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand",
    "idleTimeoutSeconds": 120,
    "secretBindings": [
      {
        "key": "cubesandbox_api_key",
        "label": "CubeSandbox API Key",
        "methods": [
          "cube/run",
          "cube/submit",
          "cube/health"
        ],
        "hint": "CubeSandbox 控制面 API 访问密钥"
      }
    ]
  },
  "setup": {
    "requires": [
      {
        "anyOf": [
          "secret:cubesandbox_api_key"
        ]
      }
    ]
  },
  "tools": [
    {
      "name": "cube_version",
      "description": "查看 cube-cli 版本号与运行平台信息",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cube_health",
      "description": "检查 CubeSandbox 控制面连接与健康状态",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cube_run",
      "description": "执行 cube-cli 命令（支持 new, ls, rm, exec, code, info, logs, template, ports 等全量控制面功能）",
      "parameters": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string",
            "description": "子命令名称（如 new, ls, rm, exec, code, info 等）"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "传递给子命令的参数列表（如 [\"--need=code\"], [\"sid\", \"uname -a\"]）"
          }
        },
        "required": [
          "cmd"
        ]
      }
    },
    {
      "name": "cube_submit",
      "description": "异步提交长时间运行的任务（如创建大模板沙箱、长时间执行代码），立即返回 taskId",
      "parameters": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string",
            "description": "要异步执行的子命令"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "传递给子命令的参数列表"
          }
        },
        "required": [
          "cmd"
        ]
      }
    },
    {
      "name": "cube_log",
      "description": "获取由 cube_submit 提交的后台任务输出日志",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "异步任务 ID"
          },
          "offset": {
            "type": "integer",
            "description": "从第几行开始读取日志（缺省从头读取）"
          }
        },
        "required": [
          "taskId"
        ]
      }
    },
    {
      "name": "cube_kill",
      "description": "终止正在运行的后台异步任务",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "异步任务 ID"
          }
        },
        "required": [
          "taskId"
        ]
      }
    }
  ]
}