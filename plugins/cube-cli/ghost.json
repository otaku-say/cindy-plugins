{\n  \"schemaVersion\": 3,\n  \"id\": \"cube-cli\",\n  \"name\": \"Cube CLI\",\n  \"description\": \"CubeSandbox 控制面遥控器：创建、管理沙箱生命周期、端口与文件操作\",\n  \"whenToUse\": \"需要创建、列出、检查、暂停、恢复、快照、克隆或删除 CubeSandbox，或排查控制面连接时\",\n  \"version\": \"0.1.0\",\n  \"minCindyVersion\": \"3.0.0\",\n  \"entry\": \"main.js\",\n  \"command\": \"cube\",\n  \"icon\": \"assets/icon.png\",\n  \"manual\": {\n    \"items\": [\n      {\n        \"dir\": \"manual/guide\",\n        \"name\": \"guide\",\n        \"description\": \"Cube CLI 完整使用手册与沙箱控制面工作流指引\"\n      }\n    ]\n  },\n  \"settingsHtml\": \"settings.html\",\n  \"node\": {\n    \"entry\": \"node/worker.cjs\",\n    \"protocol\": \"json-rpc-stdio\",\n    \"lifecycle\": \"on-demand\",\n    \"idleTimeoutSeconds\": 120,\n    \"secretBindings\": [\n      {\n        \"key\": \"cubesandbox_api_key\",\n        \"label\": \"CubeSandbox API Key\",\n        \"methods\": [\n          \"cube/run\",\n          \"cube/submit\",\n          \"cube/health\"\n        ],\n        \"hint\": \"CubeSandbox 控制面 API 访问密钥\"\n      }\n    ]\n  },\n  \"setup\": {\n    \"requires\": [\n      {\n        \"anyOf\": [\n          \"secret:cubesandbox_api_key\"\n        ]\n      }\n    ]\n  },\n  \"tools\": [\n    {\n      \"name\": \"cube_version\",\n      \"description\": \"查看 cube-cli 版本号与运行平台信息\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"name\": \"cube_health\",\n      \"description\": \"检查 CubeSandbox 控制面连接与健康状态\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"name\": \"cube_run\",\n      \"description\": \"执行 cube-cli 命令（支持 new, ls, rm, exec, code, info, logs, template, ports 等全量控制面功能）\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"cmd\": {\n            \"type\": \"string\",\n            \"description\": \"子命令名称（如 new, ls, rm, exec, code, info 等）\"\n          },\n          \"args\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"传递给子命令的参数列表（如 [\\\"--need=code\\\"], [\\\"sid\\\", \\\"uname -a\\\"]）\"\n          }\n        },\n        \"required\": [\n          \"cmd\"\n        ]\n      }\n    },\n    {\n      \"name\": \"cube_submit\",\n      \"description\": \"异步提交长时间运行的任务（如创建大模板沙箱、长时间执行代码），立即返回 taskId\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"cmd\": {\n            \"type\": \"string\",\n            \"description\": \"要异步执行的子命令\"\n          },\n          \"args\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"传递给子命令的参数列表\"\n          }\n        },\n        \"required\": [\n          \"cmd\"\n        ]\n      }\n    },\n    {\n      \"name\": \"cube_log\",\n      \"description\": \"获取由 cube_submit 提交的后台任务输出日志\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"taskId\": {\n            \"type\": \"string\",\n            \"description\": \"异步任务 ID\"\n          },\n          \"offset\": {\n            \"type\": \"integer\",\n            \"description\": \"从第几行开始读取日志（缺省从头读取）\"\n          }\n        },\n        \"required\": [\n          \"taskId\"\n        ]\n      }\n    },\n    {\n      \"name\": \"cube_kill\",\n      \"description\": \"终止正在运行的后台异步任务\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"taskId\": {\n            \"type\": \"string\",\n            \"description\": \"异步任务 ID\"\n          }\n        },\n        \"required\": [\n          \"taskId\"\n        ]\n      }\n    }\n  ]\n}