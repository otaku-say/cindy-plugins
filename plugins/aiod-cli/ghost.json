{
  "schemaVersion": 3,
  "id": "aiod-cli",
  "name": "Aiod CLI",
  "description": "CubeSandbox 沙箱内 aiod v2 API 遥控器：进程执行、文件管理、浏览器与 MCP",
  "whenToUse": "需要深入 CubeSandbox 沙箱内执行命令、管理文件、遥控浏览器、执行代码或启动 MCP Server 时",
  "version": "0.1.0",
  "minCindyVersion": "3.0.0",
  "entry": "main.js",
  "command": "aiod",
  "icon": "assets/icon.png",
  "manual": {
    "items": [
      {
        "dir": "manual/guide",
        "name": "guide",
        "description": "Aiod CLI 完整使用手册与沙箱内部系统操作指引"
      }
    ]
  },
  "settingsHtml": "settings.html",
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand",
    "idleTimeoutSeconds": 120,
    "secretBindings": [
      {
        "key": "sandbox_key",
        "label": "Sandbox Key",
        "methods": ["aiod/run", "aiod/submit", "aiod/health"],
        "hint": "沙箱内 aiod 网关鉴权 Key（可选）"
      }
    ]
  },
  "setup": {
    "requires": []
  },
  "tools": [
    {
      "name": "aiod_version",
      "description": "查看 aiod-cli 版本号与运行平台信息",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "aiod_health",
      "description": "检查当前配置的沙箱内 aiod 服务的健康与连通状态",
      "parameters": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string",
            "description": "沙箱网关地址（可选，如不传则使用默认配置中的 SANDBOX_BASE）"
          }
        }
      }
    },
    {
      "name": "aiod_run",
      "description": "执行 aiod-cli 命令（支持 exec, files, pty, browser, misc 等沙箱内部操作）",
      "parameters": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string",
            "description": "子命令名称（如 exec, ls, cat, write, upload, download, browser 等）"
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "传递给子命令的参数列表"
          },
          "base": {
            "type": "string",
            "description": "针对指定沙箱实例的网关地址（可选）"
          }
        },
        "required": ["cmd"]
      }
    },
    {
      "name": "aiod_submit",
      "description": "异步提交沙箱内的长任务，立即返回 taskId",
      "parameters": {
        "type": "object",
        "properties": {
          "cmd": { "type": "string", "description": "要异步执行的子命令" },
          "args": { "type": "array", "items": { "type": "string" }, "description": "参数列表" },
          "base": { "type": "string", "description": "沙箱网关地址（可选）" }
        },
        "required": ["cmd"]
      }
    },
    {
      "name": "aiod_log",
      "description": "获取由 aiod_submit 提交的后台任务输出日志",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "任务 ID" },
          "offset": { "type": "integer", "description": "起始行/偏移" }
        },
        "required": ["taskId"]
      }
    },
    {
      "name": "aiod_kill",
      "description": "终止正在运行的沙箱内异步任务",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "任务 ID" }
        },
        "required": ["taskId"]
      }
    }
  ]
}
