{\n  \"schemaVersion\": 3,\n  \"id\": \"aiod-cli\",\n  \"name\": \"Aiod CLI\",\n  \"description\": \"CubeSandbox 沙箱内 aiod v2 API 遥控器：进程执行、文件管理、浏览器与 MCP\",\n  \"whenToUse\": \"需要深入 CubeSandbox 沙箱内执行命令、管理文件、遥控浏览器、执行代码或启动 MCP Server 时\",\n  \"version\": \"0.1.0\",\n  \"minCindyVersion\": \"3.0.0\",\n  \"entry\": \"main.js\",\n  \"command\": \"aiod\",\n  \"icon\": \"assets/icon.png\",\n  \"manual\": {\n    \"items\": [\n      {\n        \"dir\": \"manual/guide\",\n        \"name\": \"guide\",\n        \"description\": \"Aiod CLI 完整使用手册与沙箱内部系统操作指引\"\n      }\n    ]\n  },\n  \"settingsHtml\": \"settings.html\",\n  \"node\": {\n    \"entry\": \"node/worker.cjs\",\n    \"protocol\": \"json-rpc-stdio\",\n    \"lifecycle\": \"on-demand\",\n    \"idleTimeoutSeconds\": 120,\n    \"secretBindings\": [\n      {\n        \"key\": \"sandbox_key\",\n        \"label\": \"Sandbox Key\",\n        \"methods\": [\n          \"aiod/run\",\n          \"aiod/submit\",\n          \"aiod/health\"\n        ],\n        \"hint\": \"沙箱内 aiod 网关鉴权 Key（可选）\"\n      }\n    ]\n  },\n  \"setup\": {\n    \"requires\": []\n  },\n  \"tools\": [\n    {\n      \"name\": \"aiod_version\",\n      \"description\": \"查看 aiod-cli 版本号与运行平台信息\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"name\": \"aiod_health\",\n      \"description\": \"检查当前配置的沙箱内 aiod 服务的健康与连通状态\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"base\": {\n            \"type\": \"string\",\n            \"description\": \"沙箱网关地址（可选，如不传则使用默认配置中的 SANDBOX_BASE）\"\n          }\n        }\n      }\n    },\n    {\n      \"name\": \"aiod_run\",\n      \"description\": \"执行 aiod-cli 命令（支持 exec, files, pty, browser, misc 等沙箱内部操作）\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"cmd\": {\n            \"type\": \"string\",\n            \"description\": \"子命令名称（如 exec, ls, cat, write, upload, download, browser 等）\"\n          },\n          \"args\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"传递给子命令的参数列表\"\n          },\n          \"base\": {\n            \"type\": \"string\",\n            \"description\": \"针对指定沙箱实例的网关地址（可选）\"\n          }\n        },\n        \"required\": [\n          \"cmd\"\n        ]\n      }\n    },\n    {\n      \"name\": \"aiod_submit\",\n      \"description\": \"异步提交沙箱内的长任务，立即返回 taskId\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"cmd\": {\n            \"type\": \"string\",\n            \"description\": \"要异步执行的子命令\"\n          },\n          \"args\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"参数列表\"\n          },\n          \"base\": {\n            \"type\": \"string\",\n            \"description\": \"沙箱网关地址（可选）\"\n          }\n        },\n        \"required\": [\n          \"cmd\"\n        ]\n      }\n    },\n    {\n      \"name\": \"aiod_log\",\n      \"description\": \"获取由 aiod_submit 提交的后台任务输出日志\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"taskId\": {\n            \"type\": \"string\",\n            \"description\": \"任务 ID\"\n          },\n          \"offset\": {\n            \"type\": \"integer\",\n            \"description\": \"起始行/偏移\"\n          }\n        },\n        \"required\": [\n          \"taskId\"\n        ]\n      }\n    },\n    {\n      \"name\": \"aiod_kill\",\n      \"description\": \"终止正在运行的沙箱内异步任务\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"taskId\": {\n            \"type\": \"string\",\n            \"description\": \"任务 ID\"\n          }\n        },\n        \"required\": [\n          \"taskId\"\n        ]\n      }\n    }\n  ]\n}